# Protego Backend Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/protego_db?schema=public"
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/protego_db?schema=public"

# Authentication & Tokens
JWT_SECRET="your_super_secret_jwt_key_at_least_32_characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your_super_secret_refresh_jwt_key_at_least_32_characters"
JWT_REFRESH_EXPIRES_IN="7d"

# Real-time & Caching (Optional: Redis for production pub/sub)
REDIS_URL="redis://localhost:6379"

# AI Inference Service
AI_SERVICE_URL="http://localhost:8000"

# Cloud Media Storage (Cloudinary - for incident evidence uploads)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Optional Maps API Key (if reverse-geocoding on backend)
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"
