generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  user_id      String         @id @default(uuid())
  full_name    String
  email        String         @unique
  phone        String
  password     String
  address      String?
  nid_number   String?        @unique
  avatar_url   String?
  role_id      String
  created_at   DateTime       @default(now())
  
  role            Role           @relation(fields: [role_id], references: [role_id])
  general_diaries GeneralDiary[]
  crime_reports   CrimeReport[]
  notifications   Notification[]
  sos_alerts      SOSAlert[]
  activity_logs   ActivityLog[]
  refresh_tokens  RefreshToken[]
}

model Role {
  role_id     String           @id @default(uuid())
  name        String           @unique
  description String?
  
  users       User[]
  permissions RolePermission[]
}

model Permission {
  permission_id String           @id @default(uuid())
  name          String           @unique
  
  roles         RolePermission[]
}

model RolePermission {
  role_id       String
  permission_id String
  
  role          Role       @relation(fields: [role_id], references: [role_id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

model GeneralDiary {
  gd_id       String   @id @default(uuid())
  user_id     String
  title       String
  description String
  status      String   @default("PENDING")
  created_at  DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model CrimeReport {
  report_id   String   @id @default(uuid())
  user_id     String
  crime_type  String
  description String
  location    String
  date_time   DateTime
  status      String   @default("PENDING")
  
  user        User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  evidence    Evidence[]
  case        Case?
  ai_analysis AIAnalysis?
}

model Evidence {
  evidence_id String   @id @default(uuid())
  report_id   String
  file_type   String
  file_url    String
  uploaded_at DateTime @default(now())

  crime_report CrimeReport @relation(fields: [report_id], references: [report_id], onDelete: Cascade)
}

model Case {
  case_id       String   @id @default(uuid())
  report_id     String   @unique
  officer_id    String
  case_status   String   @default("OPEN")
  assigned_date DateTime @default(now())
  updated_at    DateTime @updatedAt

  crime_report  CrimeReport   @relation(fields: [report_id], references: [report_id], onDelete: Cascade)
  police_officer PoliceOfficer @relation(fields: [officer_id], references: [officer_id])
  
  case_trackings CaseTracking[]
}

model CaseTracking {
  tracking_id   String   @id @default(uuid())
  case_id       String
  status_update String
  updated_by    String
  updated_at    DateTime @default(now())

  case          Case     @relation(fields: [case_id], references: [case_id], onDelete: Cascade)
}

model PoliceOfficer {
  officer_id   String   @id @default(uuid())
  name         String
  badge_number String   @unique
  station_id   String
  rank         String
  contact      String

  station      PoliceStation @relation(fields: [station_id], references: [station_id])
  cases        Case[]
}

model PoliceStation {
  station_id     String   @id @default(uuid())
  station_name   String
  location       String
  contact_number String

  officers       PoliceOfficer[]
}

model Notification {
  notification_id String   @id @default(uuid())
  user_id         String
  message         String
  type            String
  status          String   @default("UNREAD")
  sent_at         DateTime @default(now())

  user            User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model SOSAlert {
  sos_id         String   @id @default(uuid())
  user_id        String
  live_location  String
  emergency_type String
  status         String   @default("ACTIVE")
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model CrimeHotspot {
  hotspot_id  String @id @default(uuid())
  location    String
  crime_count Int    @default(0)
  risk_level  String
}

model AIAnalysis {
  analysis_id   String   @id @default(uuid())
  report_id     String   @unique
  severity_score Float
  is_fake       Boolean  @default(false)
  analysis_data Json?
  created_at    DateTime @default(now())

  crime_report  CrimeReport @relation(fields: [report_id], references: [report_id], onDelete: Cascade)
}

model AuditLog {
  audit_id     String   @id @default(uuid())
  entity_type  String
  entity_id    String
  action       String
  performed_by String
  ip_address   String?
  timestamp    DateTime @default(now())
}

model ActivityLog {
  activity_id String   @id @default(uuid())
  user_id     String
  action      String
  description String?
  timestamp   DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model RefreshToken {
  token_id    String   @id @default(uuid())
  user_id     String
  token       String   @unique
  expires_at  DateTime
  created_at  DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}
